# Optional: only needed if you enable the LLM classification layer.
# The service runs fully without any of these (rule-based by default).

# --- Gemini LLM classifier (app/llm.py) ------------------------------------
# Master switch. The LLM is only ever called when BOTH of these are true:
#   * USE_LLM=1
#   * at least one Gemini key is configured
# With either missing/disabled, no network call is made and the deterministic
# rule engine is used (and is always the fallback on any LLM failure).
#
# Get keys from Google AI Studio: https://aistudio.google.com/apikey
# Model used: gemini-2.5-flash-lite
#
# Preferred: comma-separated keys. Keys from different Google accounts/projects
# have separate free-tier daily quotas, so the app rotates through them.
GEMINI_API_KEYS=

# Backward compatibility: used only when GEMINI_API_KEYS is empty.
GEMINI_API_KEY=

USE_LLM=0

# Note: the LLM may only refine case_type / severity / confidence. It NEVER
# chooses department; routing is derived from case_type in app/investigator.py.
# It also NEVER decides relevant_transaction_id or evidence_verdict. Those stay
# 100% deterministic in app/investigator.py.
